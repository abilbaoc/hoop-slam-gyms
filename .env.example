VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase — datos de la app móvil (partidos, reservas, jugadores)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fuente de datos: "mock" (por defecto) | "firebase"
VITE_DATA_SOURCE=mock

# ── Solo DESARROLLO local ──────────────────────────────────────────────
# Fallback de auth Firebase en dev (en producción la auth va por
# /api/firebase-token con custom token; NUNCA subir estas vars a Vercel)
VITE_FIREBASE_AUTH_EMAIL=
VITE_FIREBASE_AUTH_PASSWORD=

# ── Solo SERVER (Vercel > Environment Variables, sin prefijo VITE_) ────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# FIREBASE_SERVICE_ACCOUNT=   (JSON completo del service account de Firebase)
# HOOP_WEBHOOK_URL=           (edge function notify-hoop-on-ticket)
